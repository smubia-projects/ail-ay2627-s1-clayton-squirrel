# Squirrel demo API (backend/). Copy to backend/.env for local runs; on Cloud Run
# the whole file is uploaded as the repo's DOTENV secret:
#   gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-clayton-squirrel < backend/.env
# Never commit the real .env.

# OpenRouter: every AI call (extraction, digest, assistant) goes through it.
API_KEY=your-openrouter-key
# Any OpenRouter model that supports structured outputs (response_format json_schema).
MODEL_NAME=google/gemini-2.5-flash

# Comma-separated frontend origins allowed to call the API (the Vercel URL once known).
CORS_ORIGINS=http://localhost:5173

# Shared rate-limit store (Upstash Redis). Leave empty locally to disable rate limiting.
# The short names UPSTASH_REDIS_URL / UPSTASH_REDIS_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional fallbacks per bucket (requests per IP per window); the central sheet overrides them.
RATE_LIMIT_EXTRACT_MAX=5
RATE_LIMIT_DIGEST_MAX=5
RATE_LIMIT_ASK_MAX=5
# Rolling window in seconds (432000 = 5 days).
RATE_LIMIT_WINDOW_SECONDS=432000

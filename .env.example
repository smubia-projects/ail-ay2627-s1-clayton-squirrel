# NOTE: this file is for the ORIGINAL full local app (server.py: Gmail/Outlook, SQLite,
# reminders). The deployed AI Lodge demo does not use it: see backend/.env.example (API on
# Cloud Run) and demo-frontend/.env.example (Vercel).
#
# Copy to .env (never commit .env). server.py loads it on start.

# OpenAI API key: needed for Gmail scanning, the digest and the assistant.
OPENAI_API_KEY=
# Which OpenAI model to use. gpt-5.4-mini costs about 7x less than gpt-5.5,
# which the code uses if this is left unset.
OPENAI_MODEL=gpt-5.4-mini

# Google OAuth client (Web application) for "Continue with Google" and Gmail.
# Authorised redirect URI: http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft app registration (Azure portal) for "Connect Outlook": Outlook,
# Hotmail, Live and Microsoft 365 mail. Supported accounts: any organizational
# directory and personal Microsoft accounts. Web redirect URI:
# http://localhost:8000/api/auth/microsoft/callback
# API permissions (delegated): Mail.Read, User.Read, offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: outgoing email for password reset links (any SMTP server, e.g.
# Gmail with an app password: smtp.gmail.com, port 587). Without SMTP_HOST,
# reset links are printed in the server terminal instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# MAIL_FROM=Squirrel <you@gmail.com>

# Optional: where the app is served (default http://127.0.0.1:8000).
# APP_URL=http://127.0.0.1:8000
